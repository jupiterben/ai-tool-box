{
  "name": "ai-tool-box",
  "version": "1.0.18",
  "description": "AI Tool Box - 集成多个主流 AI 工具的应用",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "tauri": "tauri",
    "desktop:compile": "node scripts/build-sidecar.mjs",
    "desktop:build": "tauri build",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 tests/imageGenApi.e2e.ts",
    "test:desktop": "node tests/tauri-native.mjs",
    "test:ui": "playwright test",
    "generate:icon": "node scripts/generate-icon.mjs",
    "release": "node scripts/publish-tag.mjs",
    "doc": "concurrently -k \"node scripts/docsify-sidebar.mjs --watch\" \"npx --yes docsify-cli serve docs\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "antd": "6.5.0",
    "@tauri-apps/api": "2.12.3",
    "proxy-chain": "3.0.1",
    "undici": "8.11.2",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "4.4.12",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "@tauri-apps/cli": "2.12.2",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "png-to-ico": "3.0.1",
    "react-transition-group": "4.4.5",
    "sharp": "0.35.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.3.3"
  },
  "author": "",
  "license": "MIT"
}
