{
  "name": "ai-tool-box",
  "version": "1.0.18",
  "description": "AI Tool Box - 集成多个主流 AI 工具的应用",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "pnpm run electron:compile && cross-env ELECTRON_DEV=1 ELECTRON_DISABLE_SANDBOX=1 concurrently -k \"vite\" \"wait-on -t 120000 tcp:127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 tests/imageGenApi.e2e.ts",
    "electron:compile": "node electron/esbuild.mjs",
    "electron:build": "pnpm run generate:icon && pnpm run build && pnpm run electron:compile && electron-builder",
    "generate:icon": "node scripts/generate-icon.mjs",
    "release": "node scripts/publish-tag.mjs",
    "doc": "concurrently -k \"node scripts/docsify-sidebar.mjs --watch\" \"npx --yes docsify-cli serve docs\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "6.5.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "4.4.12",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "cross-env": "10.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "png-to-ico": "3.0.1",
    "react-transition-group": "4.4.5",
    "sharp": "0.35.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.62.1",
    "vite": "8.3.3",
    "wait-on": "9.0.5"
  },
  "author": "",
  "license": "MIT"
}
