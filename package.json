{
  "name": "ai-tool-box",
  "version": "1.0.18",
  "description": "AI Tool Box - 集成多个主流 AI 工具的应用",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "tauri": "tauri",
    "desktop:compile": "node scripts/build-sidecar.mjs",
    "desktop:build": "tauri build",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 tests/imageGenApi.e2e.ts",
    "test:desktop": "node tests/tauri-native.mjs",
    "test:ui": "playwright test",
    "generate:icon": "node scripts/generate-icon.mjs",
    "release": "node scripts/publish-tag.mjs",
    "doc": "concurrently -k \"node scripts/docsify-sidebar.mjs --watch\" \"npx --yes docsify-cli serve docs\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "svelte-check --tsconfig ./tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "proxy-chain": "3.0.1",
    "undici": "8.11.2",
    "@lucide/svelte": "1.57.0",
    "svelte": "5.57.2",
    "marked": "18.1.1",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.6",
    "concurrently": "10.0.3",
    "@tauri-apps/cli": "2.12.2",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.7.0",
    "png-to-ico": "3.0.1",
    "sharp": "0.35.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.3.3"
  },
  "author": "",
  "license": "MIT"
}
