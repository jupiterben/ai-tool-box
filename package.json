{
  "name": "ai-tool-box",
  "version": "1.0.4",
  "description": "AI Tool Box - 集成多个主流 AI 工具的应用",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node electron/esbuild.mjs && cross-env ELECTRON_DEV=1 concurrently -k \"vite\" \"wait-on -t 120000 tcp:127.0.0.1:5173 && electron .\"",
    "build": "node scripts/generate-icon.mjs && vite build && node electron/esbuild.mjs && electron-builder"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "@lucide/svelte": "1.46.0",
    "marked": "18.0.13",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "concurrently": "10.0.3",
    "cross-env": "10.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.0",
    "png-to-ico": "3.0.1",
    "svelte-check": "4.7.6",
    "sharp": "0.35.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  },
  "author": "",
  "license": "MIT"
}
